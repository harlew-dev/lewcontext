# Test settings, committed on purpose. make test, make test-e2e, go test and
# Playwright use this file and ignore .env, however they're started.
# Only local, throwaway values: never put a real secret here
# (TestEnvTestingHoldsNoSecrets checks).
# Plain KEY=value lines only: no quotes, no spaces, no export, no $.
APP_ENV=development
# The e2e server's port. Its APP_ORIGIN, API_ADDR and its own database,
# lewcontext_test_<E2E_PORT>, are derived from it (scripts/serve-test.sh and
# playwright.config.ts). Another port per run: make test-e2e E2E_PORT=auto.
E2E_PORT=3100
# The Go tests' database: each test makes a throwaway schema in it. make db
# creates it.
DATABASE_URL=postgresql://lewcontext:password@127.0.0.1:5432/lewcontext_test?sslmode=disable
# One e2e run signs up more users from one IP than register:per-ip allows.
RATE_LIMITS=off
# The e2e server's email goes to Mailpit (make db), where the tests read it
# through its API at MAILPIT_URL. Runs share it: each finds its own mail by
# its unique recipients.
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@lewcontext.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAILPIT_URL=http://127.0.0.1:8025
