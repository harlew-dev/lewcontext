# Local test environment only. Use a dedicated restricted DB role and TLS in production.
# Product name shown in page titles, the logo and the app (baked into the web build).
APP_NAME=lewcontext
DATABASE_URL=postgresql://lewcontext:password@127.0.0.1:5432/lewcontext?sslmode=disable
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_ADDR=127.0.0.1:8080
API_URL=http://127.0.0.1:8080
# Email: "smtp" sends it through SMTP_HOST, here Mailpit from make db, whose
# inbox is http://localhost:8025. "log" appends it to MAIL_FILE instead (a
# development mailbox; make sets it to tmp/mail.log in the repository), and
# "off" sends none. Production needs smtp with TLS, or off.
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@lewcontext.test
# MAIL_FROM_NAME defaults to APP_NAME.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
# A real provider instead (docs/deployment.md#email), for example Resend:
#   SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_TLS=starttls
#   SMTP_USERNAME=resend SMTP_PASSWORD=<an API key>
# or Mailtrap's online test inbox for staging, with its SMTP settings.
# Rate limits are on unless the server starts with RATE_LIMITS=off, which the
# end-to-end tests need (RATE_LIMITS=off make serve). Don't set it here: make's
# .env values win over the command line. Production refuses off.
# Behind a proxy (production): the header it puts the client's address in, and
# the addresses or CIDR ranges it connects from. Set both or neither; the
# header is believed only from those. Locally, leave them unset.
# CLIENT_IP_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Used only by the explicit development seed command.
DEMO_PASSWORD=password
