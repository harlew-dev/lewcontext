# Local development settings: cp .env.example .env (make loads .env).
# Every variable: docs/api/README.md#environment. Production: docs/deployment.md.

# App: its name (baked into the web build), mode and public origin, and the
# key that seals two-factor secrets. This key is for local use only and
# production refuses it; make app-key writes a new one into a .env without one.
APP_NAME=lewcontext
APP_ENV=development
APP_ORIGIN=http://localhost:3000
APP_KEY=O1Uo2N3TlBVsoKbrO0rTLwuE7DArCGLH2tWmaL8jMQA=

# Admin dashboard: http://localhost:3000/admin/<this key>. It hides the door,
# it doesn't authenticate: an admin still needs their password and a second
# factor (make admin cmd=grant email=… CONFIRM=1). Local use only; production
# refuses it. Leave it empty to turn admin off. docs/api/admin.md.
ADMIN_ROUTE_KEY=ZPycpaTc6D_ZYGNirUyhk42QUAMY-uT4M3ji3CEnzWw
# Optional: after a rotation, the old key, whose sessions keep working until
# they end (it opens no sign-in); and the only client addresses or ranges the
# admin dashboard answers (unset: any).
# ADMIN_ROUTE_KEY_PREVIOUS=
# ADMIN_ALLOWED_IPS=127.0.0.1,::1

# API server: where Go listens, and where Vite's dev proxy finds it.
API_ADDR=127.0.0.1:8080
API_URL=http://127.0.0.1:8080

# Database: the local PostgreSQL that make db starts.
DATABASE_URL=postgresql://lewcontext:password@127.0.0.1:5432/lewcontext?sslmode=disable

# Mail: to Mailpit from make db, inbox at http://localhost:8025.
# Other drivers and real providers: docs/api/mail.md, docs/deployment.md#email.
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=no-reply@lewcontext.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=

# Email verification: a sign-up enters a 6-digit code sent to its email
# (Mailpit locally) before the account exists. on (the default) or off; off is
# needed with MAIL_DRIVER=off. EMAIL_VERIFICATION_EXISTING=required makes
# accounts that never verified do so at their next sign-in. docs/api/auth.md.
EMAIL_VERIFICATION=on
EMAIL_VERIFICATION_EXISTING=optional

# The terms of service and privacy policy (apps/web/content/policy/*.md):
# on publishes /policy/terms-of-service and /policy/privacy-policy and makes
# sign-up agree to them. off (the default) until you've edited the templates;
# production refuses on while either is still marked boilerplate.
# docs/deployment.md#terms-of-service-and-privacy-policy.
POLICIES=off

# Behind a proxy, in production only: docs/deployment.md#behind-a-proxy-or-load-balancer.
# CLIENT_IP_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Seed: the password of the accounts make seed creates.
DEMO_PASSWORD=password
