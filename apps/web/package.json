{
  "name": "lewcontext-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "WEB_BUILD=app react-router dev",
    "dev:admin": "WEB_BUILD=admin react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts vitest.config.ts vite.config.ts react-router.config.ts web-build.ts eslint.config.mjs",
    "format:check": "prettier --check src tests playwright.config.ts vitest.config.ts vite.config.ts react-router.config.ts web-build.ts eslint.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "baseui": "18.2.0",
    "motion": "^12.43.0",
    "qrcode-generator": "^2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "react-router": "^7.18.5",
    "recharts": "3.10.1",
    "styletron-engine-atomic": "1.6.2",
    "styletron-react": "6.1.1",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react-uid": "2.4.0",
    "react-window": "1.8.11",
    "react-virtualized-auto-sizer": "1.0.26"
  },
  "type": "module"
}
