{
  "name": "forma-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts vitest.config.ts eslint.config.mjs next.config.mjs postcss.config.mjs",
    "format:check": "prettier --check src tests playwright.config.ts vitest.config.ts eslint.config.mjs next.config.mjs postcss.config.mjs"
  },
  "dependencies": {
    "baseui": "18.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styletron-engine-atomic": "1.6.2",
    "styletron-react": "6.1.1",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react-uid": "2.4.0",
    "react-window": "1.8.11",
    "react-virtualized-auto-sizer": "1.0.26"
  },
  "type": "module"
}
